# Apollo People Enrichment. Keep the real value in ignored `.env.local` locally
# and configure it as a secret in the hosted Sites environment.
APOLLO_API_KEY=replace_with_a_scoped_apollo_api_key

# Preferred web-research provider. Parallel Chat searches the current public
# web and returns a concise answer with source URLs.
PARALLEL_API_KEY=replace_with_a_parallel_api_key
PARALLEL_MODEL=speed

# Grounded AI web research. The Gemini Interactions API uses Google Search and
# returns source citations with each result. Pomade uses this as a fallback when
# PARALLEL_API_KEY is not configured.
GEMINI_API_KEY=replace_with_a_google_ai_studio_api_key
GEMINI_MODEL=gemini-3.8-flash

# Optional read-only CRM sources. Pomade never sends writes with these values.
HUBSPOT_ACCESS_TOKEN=replace_with_a_contacts_read_token
SALESFORCE_INSTANCE_URL=https://your-domain.my.salesforce.com
SALESFORCE_ACCESS_TOKEN=replace_with_a_salesforce_access_token
SALESFORCE_API_VERSION=67.0

# Generic HTTP connections. Credentials remain server-side. Enable only methods
# appropriate for the enrichment endpoints you intend to call. Local HTTP origins
# are supported for self-hosted/internal services; use HTTPS for remote providers.
# POMADE_HTTP_CONNECTIONS='{"my_api":{"label":"My enrichment API","origin":"https://api.example.com","methods":["GET","POST"],"headers":{"Authorization":"Bearer replace_me"}}}'

# Incoming JSON events, routed to a table inbox. Generate a long random token locally.
# POMADE_WEBHOOK_SOURCES='{"leads":{"tableId":"founder-targets","token":"replace-with-at-least-32-random-characters"}}'
